  "components": {
    "schemas": {
      "AddMessageRequest": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "AddMessageRequest"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/RoleEnum"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "title": "Model"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Messages"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "top_p": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top P"
          }
        },
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatRequest"
      },
      "CreateKeyRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "rate_limit_max": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Rate Limit Max",
            "default": 60
          },
          "rate_limit_window_ms": {
            "type": "integer",
            "maximum": 3600000.0,
            "minimum": 1000.0,
            "title": "Rate Limit Window Ms",
            "default": 60000
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateKeyRequest"
      },
      "CreateSessionRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "default": "New chat"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "groq"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "llama-3.3-70b-versatile"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RoleEnum": {
        "type": "string",
        "enum": [
          "system",
          "user",
          "assistant"
        ],
        "title": "RoleEnum"
      },
      "UpdateKeyRequest": {
        "properties": {
          "name": {
            "anyOf": [
