# Neon/PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://user:password@host/db

# TLS to Postgres: require | disable
#
# "require" verifies the server certificate and is correct for Neon and any
# managed database. Set "disable" ONLY for a local container or CI service that
# presents a self-signed certificate. There is no "auto" mode: choosing TLS by
# probing would mean opening an unencrypted connection first, which transmits
# the database password in cleartext to whatever host DATABASE_URL names.
DATABASE_SSL=require

# Admin bypass key (must start with sk-gateway-)
GATEWAY_API_KEY=sk-gateway-dev-key

# Provider API keys (at least one required for real routing)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Dashboard accounts (/auth) ---
#
# Self-service signup is convenient locally and wrong in production: anyone who
# finds /register gets an account that can spend the owner's provider balance
# through the dashboard. Set false there and mint accounts with:
#   python -m scripts.create_user --email you@example.com --admin
ALLOW_REGISTRATION=true

# Browser session lifetime, applied to both the cookie Max-Age and the
# auth_sessions.expires_at row, so a cookie kept past its lifetime stops working.
SESSION_COOKIE_NAME=gw_session
SESSION_TTL_SECONDS=604800

# PBKDF2-HMAC-SHA256 cost (OWASP's figure for this construction). The value is
# stored inside each encoded hash, so raising it rehashes on next login rather
# than invalidating existing passwords.
PASSWORD_HASH_ITERATIONS=600000

# Per-IP attempt budget for login/register, bounding credential stuffing.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Use X-Forwarded-For for that per-IP bucket. Off by default: the header is
# attacker-controlled, so trusting it unconditionally makes the limiter free to
# bypass. Turn it on only behind a proxy that overwrites it.
TRUST_FORWARDED_FOR=false

PORT=8000
LOG_LEVEL=info

# --- CORS ---
#
# Off by default, and that is correct for this deployment: the dashboard calls
# the API server-side from Next.js route handlers, where CORS does not apply,
# and the API authenticates with a bearer token rather than a cookie.
#
# The previous setting was allow_origins=["*"] with allow_credentials=True,
# which Starlette resolves into "reflect any Origin and allow credentials".
# Only set this if a browser is expected to call the API directly, and list
# origins explicitly rather than a wildcard.
# CORS_ALLOW_ORIGINS=https://your-frontend.example.com

# --- Websocket limits (/ws/chat) ---
#
# Defaults apply if unset. WS_MAX_MESSAGE_BYTES should match uvicorn's
# --ws-max-size: the server flag rejects an oversized frame before buffering
# it, and this one is what the application enforces afterwards. Setting only the
# env var leaves a window where a large frame is already in memory.
WS_MAX_MESSAGE_BYTES=65536
WS_MAX_MESSAGES_PER_REQUEST=64
WS_MAX_TURNS_PER_CONNECTION=200
# Share the HTTP rate-limit budget with websocket connections. Turning this off
# lets a key that is already rate-limited over /chat get a fresh budget by
# opening a socket instead.
WS_RATE_LIMIT=true
# Per-message rate limiting does not bound sockets that never send anything, so
# open connections are capped separately. Charged at the handshake too, so a
# key cannot open connections for free.
WS_MAX_CONNECTIONS_PER_KEY=8